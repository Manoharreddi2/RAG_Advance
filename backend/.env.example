# ---- Core ----
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-bytes
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
ALLOW_REGISTRATION=true

# ---- Infrastructure ----
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
STORAGE_DIR=./data/uploads
INGEST_MODE=queue            # queue = arq worker process; inline = in the API process

# ---- LLM ----
# auto: openai if OPENAI_API_KEY is set, else openai_compatible if OPENAI_BASE_URL is set, else local
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Ollama / vLLM / LM Studio (OpenAI-compatible):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1:8b
# Google Gemini (free tier, OpenAI-compatible):
# LLM_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=<your Gemini API key>
# OPENAI_MODEL=gemini-3.1-flash-lite   # larger free quota than gemini-2.5-flash
# LLM_REASONING_EFFORT=none           # only for thinking models such as gemini-2.5-flash
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# LLM_REASONING_EFFORT=
# Price actually paid per 1M tokens (0 for free tiers/local models) and the reference price for projections
PRICE_INPUT_PER_M=0.15
PRICE_OUTPUT_PER_M=0.60
PROJECTED_PRICE_INPUT_PER_M=0.15
PROJECTED_PRICE_OUTPUT_PER_M=0.60

# ---- Models ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEVICE=cpu

# ---- Retrieval / performance ----
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=30
ABSTAIN_THRESHOLD=-4.0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20
